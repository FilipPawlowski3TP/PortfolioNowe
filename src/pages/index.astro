---
// VISUAL PATCH v3 (user decisions 2026-11-17): multi-page site — the dark
// word section is removed, FAQ and Kontakt live on their own pages.
// Homepage order: Hero → Zdanie przewodnie → Realizacje → Oferta → Proces.
// SeoHead + JSON-LD untouched.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Guiding from '../components/Guiding.astro';
import Realizacje from '../components/Realizacje.astro';
import Offer from '../components/Offer.astro';
import Process from '../components/Process.astro';
import Footer from '../components/Footer.astro';
import '../styles/interactions.css';
---

<Base>
  <Header />
  <main id="tresc">
    <Hero />
    <!-- §4: the curtain — everything after the hero paints over it (opaque,
         z-index 2) while the pinned hero drifts underneath. -->
    <div class="after-hero" data-curtain>
      <Guiding />
      <Realizacje />
      <Offer />
      <Process />
    </div>
  </main>
  <Footer giant />
</Base>
