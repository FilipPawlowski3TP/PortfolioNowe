---
// VISUAL RESET v2 §5.1/§6 — Hero + realization window ("wizytówka → strona").
// The card is a static placeholder (thumbnail, aspect = browser window); the
// frame is the full-viewport window with the full realization shot, scaled
// onto the card by the pinned sequence (motion mode only — Krok 2).
import T from './T.astro';
import { site } from '../data/site';
---

<section class="hero" id="hero" data-hero>
  <div class="container hero__inner">
    <h1 class="hero__h1" data-hero-text>
      {
        site.hero.h1.map((line) => (
          <span class="hero__line">
            <T text={line} />
          </span>
        ))
      }
    </h1>

    <div class="hero__text" data-hero-text>
      <p class="hero__lead">
        <T text={site.hero.lead} />
      </p>
      <div class="hero__ctas">
        {
          site.hero.ctas.map((cta) => (
            <a class={`btn btn--${cta.variant}`} href={cta.href}>
              <T text={cta.label} />
            </a>
          ))
        }
      </div>
    </div>

    <figure class="hero__shot" data-card>
      <div class="hero__shot-frame">
        <img
          src="/media/case-desktop-thumb.webp"
          width="900"
          height="562"
          fetchpriority="high"
          decoding="async"
          alt="Pierwszy ekran strony Koparki Pawłowski — realizacja studia"
        />
      </div>
      <figcaption class="caption">Realizacja: Koparki Pawłowski</figcaption>
    </figure>
  </div>

  <!-- The window (§6): full-viewport frame, transformed onto the card at rest.
       Hidden unless html.motion-on (live pinned sequence). The wrap is what
       the intro slides (the frame's own transform belongs to the sequence). -->
  <div class="hero__frame-wrap" data-frame-wrap>
    <div class="hero__frame" data-frame>
    <img
      class="hero__frame-img"
      data-frame-img
      src="/media/case-desktop-full.webp"
      width="1440"
      height="3150"
      loading="lazy"
      decoding="async"
      alt="Pełna strona realizacji Koparki Pawłowski"
    />
    <div class="hero__frame-pill" data-frame-pill>
      <a href="https://koparkapawlowski.pl/" target="_blank" rel="noopener">Koparki Pawłowski — zobacz na żywo</a>
    </div>
    <div class="hero__frame-progress" data-frame-progress aria-hidden="true">
      <span data-frame-progress-bar></span>
    </div>
    </div>
  </div>
</section>
