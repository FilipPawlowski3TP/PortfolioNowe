---
// Act I — Hero. PATCH v1.1: no drawing decorations; the LayerStack object
// is anchored on the right by an empty placeholder (its box = object placement).
import T from './T.astro';
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="hero-h1">
  <div class="hero__frame">
    <div class="hero__content">
      <h1 id="hero-h1" class="hero__h1" data-hero="title">
        <T text={site.hero.h1} />
      </h1>

      <p class="hero__lead" data-hero="lead">
        <T text={site.hero.lead} />
      </p>

      <div class="hero__ctas" data-hero="ctas">
        {
          site.hero.ctas.map((cta) => (
            <a class:list={['btn', cta.variant === 'primary' ? 'btn--primary' : 'btn--secondary']} href={cta.href}>
              <T text={cta.label} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__stage" data-anchor="hero" aria-hidden="true"></div>
  </div>
</section>
