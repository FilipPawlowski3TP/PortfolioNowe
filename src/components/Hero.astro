---
// VISUAL PATCH v3 §1 (Krok 0): the Koparki hero spotlight (thumbnail, expanding
// window, screenshot scroll, pill) is removed; §3 rebuilds the hero in Krok 1.
import T from './T.astro';
import { site } from '../data/site';
---

<section class="hero" id="hero" data-hero>
  <div class="container hero__inner">
    <h1 class="hero__h1" data-hero-text>
      {
        site.hero.h1.map((line) => (
          <span class="hero__line">
            <T text={line} />
          </span>
        ))
      }
    </h1>

    <div class="hero__text" data-hero-text>
      <p class="hero__lead">
        <T text={site.hero.lead} />
      </p>
      <div class="hero__ctas">
        {
          site.hero.ctas.map((cta) => (
            <a class={`btn btn--${cta.variant}`} href={cta.href}>
              <T text={cta.label} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
