---
// VISUAL RESET v2 §5.4 — Oferta: numbered rows (01–04), no cards.
// Hover (desktop): row shifts 12px, number and arrow turn --signal (Krok 3
// adds the drawn line on enter; static here).
import T from './T.astro';
import { site } from '../data/site';

const nums = ['01', '02', '03', '04', '05', '06'];
---

<section class="section offer" id={site.offer.id} aria-labelledby="offer-h2">
  <div class="container">
    <div class="offer__head">
      <h2 id="offer-h2">
        <T text={site.offer.heading} />
      </h2>
    </div>

    <ol class="offer__rows">
      {
        site.offer.services.map((service, i) => (
          <li class="offer-row">
            <span class="offer-row__num" aria-hidden="true">
              {nums[i] ?? String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="offer-row__name">
              <T text={service.name} />
            </h3>
            <p class="offer-row__desc">
              <T text={service.what} />
            </p>
            <span class="offer-row__arrow" aria-hidden="true">
              →
            </span>
            <svg class="offer-row__line" aria-hidden="true" width="100%" height="2" viewBox="0 0 100 2" preserveAspectRatio="none">
              <line x1="0" y1="1" x2="100" y2="1" pathLength="100"></line>
            </svg>
          </li>
        ))
      }
    </ol>
  </div>
</section>
