---
// VISUAL RESET v2 §5.2 — Realizacja (fakty): two columns, facts only.
// Every number in the blocks is backed by docs/BRIEF.md §5.3–5.4.
import T from './T.astro';
import { site } from '../data/site';

const c = site.caseStudy;
---

<section class="section realizacja" id={c.id} aria-labelledby="realizacja-h2">
  <div class="container realizacja__grid">
    <div class="realizacja__intro">
      <h2 id="realizacja-h2">
        <T text={c.heading} />
      </h2>
      <p>
        <T text={c.description} />
      </p>
      <a class="btn btn--secondary realizacja__cta" href={c.cta.href} target="_blank" rel="noopener">
        <T text={c.cta.label} />
      </a>
    </div>

    <div class="realizacja__facts">
      {
        c.blocks.map((block) => (
          <div class="fact-block">
            <h3>
              <T text={block.name} />
            </h3>
            <p>
              <T text={block.text} />
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
